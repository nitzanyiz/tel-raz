  .mk-anim .mk-spot.is-in > div, .mk-anim .mk-spot.is-in .mk-spot__img { opacity:1; transform:none; }
  .mk-anim .mk-stagger > * { opacity:0; transform:translateY(24px); transition:opacity .55s ease, transform .55s ease; transition-delay:calc(var(--i, 0) * 100ms); }
