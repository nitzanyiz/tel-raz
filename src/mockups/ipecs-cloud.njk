<script>
  // Animation demo: highlights slide in and card grids appear in a quick wave.
  // Each plays once. Skipped entirely with reduced motion or without IntersectionObserver.
  (function () {
    if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.documentElement.classList.add("mk-anim");
    document.querySelectorAll(".mk-stagger").forEach((g) => [...g.children].forEach((c, i) => c.style.setProperty("--i", i)));
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add("is-in");
      io.unobserve(e.target);
    }), { rootMargin: "0px 0px -25% 0px" });
    document.querySelectorAll(".mk-spot, .mk-stagger").forEach((el) => io.observe(el));
  })();
</script>

