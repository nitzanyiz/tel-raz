5 1 -578 28 -44 9 -105 19 -135 24 -30 4 -73 15 -95 23 -22 8 -76 18 -119 22 -52 4 -95 14 -125 29 -26 13 -75 26 -115 30 -37 4 -86 16 -108 27 -21 11 -65 25 -96 30 -62 11 -229 86 -250 112 -8 9 -35 19 -60 23 -77 11 -122 32 -161 72 -21 21 -67 53 -104 72 -37 18 -74 42 -84 52 -9 10 -22 18 -29 18 -7 0 -39 30 -71 67 -32 37 -105 115 -162 175 -84 87 -231 282 -231 305 0 4 -11 21 -26 40 -35 47 -49 84 -68 193 -9 52 -28 129 -40 170 -62 199 -67 336 -18 480 18 52 37 122 43 155 5 33 15 78 20 100 5 22 14 76 19 120 6 44 25 125 44 180 19 55 44 134 56 175 12 41 31 91 41 110 53 101 109 258 109 307 0 33 15 61 60 108 21 22 68 98 104 169 39 76 84 148 109 175 33 35 47 61 57 101 17 74 29 95 69 122 28 19 39 38 62 106 19 56 40 97 64 124 20 22 45 59 55 82 12 30 27 47 50 56 19 8 52 40 84 84 29 39 82 103 118 142 35 39 83 95 106 125 23 30 85 95 139 145 117 107 223 217 223 231 0 15 44 53 62 53 22 0 118 88 118 109 0 31 30 59 79 76 33 11 63 31 93 63 24 26 62 63 83 82 22 20 57 54 78 77 21 23 69 63 108 89 39 25 93 68 121 95 27 26 80 66 116 88 37 21 85 58 107 80 22 23 58 50 80 61 22 11 66 42 97 69 32 27 97 75 146 106 49 31 104 74 121 95 23 29 45 44 87 57 40 12 68 30 97 60 22 23 63 52 91 64 28 12 66 35 84 50 18 16 59 43 92 59 32 16 62 34 65 40 4 6 32 22 63 36 31 14 67 35 80 47 30 28 88 61 262 148 80 39 158 83 173 95 16 13 37 24 47 24 11 0 35 14 54 30 18 17 49 37 67 45 19 8 48 23 64 35 17 11 41 20 55 20 14 0 47 16 74 35 27 19 55 35 61 35 25 0 122 56 150 87 26 27 43 34 134 52 89 18 108 25 142 56 22 19 46 35 54 35 8 0 36 11 62 24 76 39 208 96 221 96 7 0 35 11 62 25 27 14 55 25 62 25 26 0 178 82 197 107 26 32 27 84 4 105 -17 15 -59 29 -125 43 -14 3 -40 17 -57 31 -20 16 -46 27 -76 30 -25 2 -54 8 -65 14 -10 5 -28 10 -40 10 -12 0 -68 19 -123 41 -231 94 -350 111 -443 64z"/> </g></g></symbol></defs></svg>

  <section class="hero" id="hero">
    <div class="hero-text">
      <h1>{{ home.heroTitle }}</h1>
      <p>{{ home.heroSubtitle }}</p>
      <div class="btns"><span class="b1">{{ home.heroCtaContact }}</span><span class="b2">{{ home.heroCtaCall }}</span></div>
    </div>
  </section>

  <main class="panel">
    <h2>הדגמה 2: חמישה לוגואים</h2>
    <p class="lead">שני לוגואים בכל צד, גדול וקטן: משמאל הגדול חד והקטן מטושטש, מימין להפך. למעלה באמצע לוגו גדול מטושטש. הזיזו את העכבר על פני האזור: הלוגואים זזים בעומקים שונים ויוצרים תחושת עומק (פרלקסה). הלוגואים הגדולים והמטושטשים קרובים יותר וזזים הכי הרבה, והקטן המטושטש רחוק וזז הכי מעט.</p>

    <div class="group-title">תנועה מתמדת</div>
    <label class="toggle"><input type="checkbox" id="drift"><span>הלוגואים מרחפים כל הזמן<small>תנועה איטית ועדינה גם בלי עכבר, בנוסף לפרלקסה.</small></span></label>

    <div class="group-title">הגדרות</div>
    <div class="sliders">
      <label>רוחב לוגו גדול (פיקסלים) <output id="o-big"></output><input type="range" id="c-big" min="140" max="380" value="220"></label>
      <label>רוחב לוגו קטן (פיקסלים) <output id="o-small"></output><input type="range" id="c-small" min="50" max="160" value="90"></label>
      <label>עוצמת טשטוש <output id="o-blur"></output><input type="range" id="c-blur" min="0" max="20" value="7"></label>
      <label>עוצמת הפרלקסה (פיקסלים) <output id="o-amp"></output><input type="range" id="c-amp" min="5" max="120" value="40"></label>
      <label>רכות התנועה <output id="o-speed"></output><input type="range" id="c-speed" min="1" max="10" value="4"></label>
    </div>

    <p class="note">זוהי הדגמה בלבד ואינה חלק מהאתר. בטלפון אפשר לגרור אצבע על האזור הלבן כדי לראות את התנועה.</p>
  </main>

  <script>
  (function () {
    const NS = 'http://www.w3.org/2000/svg';
    const hero = document.getElementById('hero');
    const ctl = id => document.getElementById('c-' + id);
    const ids = ['big', 'small', 'blur', 'amp', 'speed'];
    const drift = document.getElementById('drift'), t0 = performance.now();
    // x, y as fractions of the hero; size big/small; blurred or sharp; resting tilt;
    // depth = how much it moves (big blurred ones read as out-of-focus foreground)
    const spec = [
      { x: 0.11, y: 0.74, size: 'big',   blurred: false, rot: -8, depth: 0.6 },   // left, large, sharp
      { x: 0.22, y: 0.18, size: 'small', blurred: true,  rot: 10, depth: 0.25 },  // left, small, blurred
      { x: 0.89, y: 0.28, size: 'big',   blurred: true,  rot: 8, depth: 1 },      // right, large, blurred
      { x: 0.80, y: 0.84, size: 'small', blurred: false, rot: -6, depth: 0.45 },  // right, small, sharp
      { x: 0.50, y: 0.06, size: 'big',   blurred: true,  rot: 0, depth: 0.9 },    // top middle, large, blurred
    ];
    let mouse = null;
    const logos = spec.map((s, i) => {
      const el = document.createElementNS(NS, 'svg');
      el.setAttribute('class', 'logo'); el.setAttribute('viewBox', '0 0 2004 1110');
      el.innerHTML = '<use href="#r-silver-blue"/>';
      hero.insertBefore(el, hero.firstChild);
      return { ...s, el, ox: 0, oy: 0, dx: 0, dy: 0, dr: 0, ph: i * 1.9, sp: 0.8 + (i % 3) * 0.15 };
    });

    function applyLook() {
      ids.forEach(id => document.getElementById('o-' + id).textContent = ctl(id).value);
      const scale = Math.min(1, hero.clientWidth / 1200);   // keep the logos clear of the text on narrow screens
      for (const l of logos) {
        l.w = +ctl(l.size).value * scale;
        l.el.setAttribute('width', l.w); l.el.setAttribute('height', l.w * 0.554);
        l.el.style.filter = l.blurred ? `blur(${ctl('blur').value * Math.max(scale, 0.5)}px)` : '';
      }
    }

    function tick(now) {
      const W = hero.clientWidth, H = hero.clientHeight, strength = +ctl('amp').value, t = (now - t0) / 1000;
      const rate = 0.13 - +ctl('speed').value * 0.011;    // softer = slower catch-up
      // pointer position from the hero's centre, -1..1 (centre when the pointer is away)
      const px = mouse ? (mouse.x / W - 0.5) * 2 : 0, py = mouse ? (mouse.y / H - 0.5) * 2 : 0;
      for (const l of logos) {
        const cx = l.x * W, cy = l.y * H;
        l.ox += (-px * strength * l.depth - l.ox) * rate; l.oy += (-py * strength * 0.6 * l.depth - l.oy) * rate;
        // constant drift: a slow, small float around the resting spot (eases in and out with the toggle)
        const on = drift.checked ? 1 : 0, a = 6 + 10 * l.depth;
        l.dx += (on * Math.sin(t * 0.21 * l.sp + l.ph) * a - l.dx) * 0.03;
        l.dy += (on * Math.cos(t * 0.17 * l.sp + l.ph * 1.3) * a * 0.7 - l.dy) * 0.03;
        l.dr += (on * Math.sin(t * 0.13 * l.sp + l.ph) * 4 - l.dr) * 0.03;
        l.el.style.transform = `translate(${cx - l.w / 2 + l.ox + l.dx}px, ${cy - l.w * 0.277 + l.oy + l.dy}px) rotate(${l.rot + l.dr}deg)`;
      }
      requestAnimationFrame(tick);
    }

    const setPointer = e => { const r = hero.getBoundingClientRect(); mouse = { x: e.clientX - r.left, y: e.clientY - r.top }; };
    hero.addEventListener('pointermove', setPointer);
    hero.addEventListener('pointerdown', setPointer);
    hero.addEventListener('pointerleave', () => mouse = null);
    ids.forEach(id => ctl(id).addEventListener('input', applyLook));
    addEventListener('resize', applyLook);
    applyLook(); requestAnimationFrame(tick);
  })();
  </script>
</body>
</html>
