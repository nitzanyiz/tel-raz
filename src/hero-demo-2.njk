<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>הדגמה 2: חמישה לוגואים בעמוד הבית</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&display=swap">
  <style>
    :root { --navy: #33394f; --blue: #446ba4; --text: #1c2433; --muted: #5d6779; --bg: #f3f5f9; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: "Heebo", Arial, sans-serif; color: var(--text); background: var(--bg); }
    .hero { position: relative; height: min(88vh, 720px); min-height: 480px; background: #fff; overflow: hidden; touch-action: pan-y; }
    .hero svg.logo { position: absolute; left: 0; top: 0; will-change: transform; }
    .hero-text { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(680px, calc(100% - 32px)); text-align: center; pointer-events: none; z-index: 2; }
    .hero-text h1 { color: var(--navy); font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; margin: 0 0 12px; line-height: 1.2; }
    .hero-text p { color: var(--muted); font-size: clamp(1.05rem, 2.4vw, 1.3rem); margin: 0 0 28px; }
    .btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btns span { padding: 12px 26px; border-radius: 999px; font-weight: 700; }
    .b1 { background: var(--blue); color: #fff; } .b2 { border: 1.5px solid var(--blue); color: var(--blue); }

    .panel { max-width: 1100px; margin: 0 auto; padding: 28px 16px 64px; }
    .panel h2 { color: var(--navy); margin: 0 0 6px; font-size: 1.5rem; }
    .panel .lead { color: var(--muted); margin: 0 0 20px; }
    .group-title { font-weight: 700; color: var(--navy); margin: 22px 0 10px; }
    .sliders { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 16px 28px; }
    .sliders label { display: flex; flex-direction: column; gap: 6px; }
    .sliders output { font-weight: 700; color: var(--blue); }
    .sliders input { accent-color: var(--blue); width: 100%; }
    .toggle { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; max-width: 520px; }
    .toggle input { accent-color: var(--blue); width: 18px; height: 18px; margin-top: 3px; }
    .toggle small { display: block; color: var(--muted); }
    .note { margin-top: 26px; color: var(--muted); font-size: .95rem; }
  </style>
</head>
