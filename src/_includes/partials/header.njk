{%- import "partials/icons.njk" as icons -%}
{%- set tree = collections.menuPages | buildMenu(menuGroups, site) -%}
{%- macro menuLink(node) -%}
<a href="{{ node.url }}"{% if node.external %} target="_blank" rel="noopener"{% endif %}{% if node.url == page.url %} aria-current="page"{% endif %}>
  {{- node.title -}}
  {%- if node.external %} {{ icons.icon("external", "icon icon-sm") }}<span class="visually-hidden"> (נפתח בחלון חדש)</span>{% endif -%}
</a>
{%- endmacro -%}
<a class="skip-link" href="#main">דלג לתוכן</a>
<header class="site-header" data-header>
  <div class="bar">
    <a class="brand" href="/" aria-label="{{ site.name }} – דף הבית">
      <picture>
        <source srcset="/assets/img/logo.webp" type="image/webp">
        <img src="/assets/img/logo.png" alt="{{ site.name }}" width="180" height="44">
      </picture>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="תפריט ראשי">
      <ul class="nav-top">
        {%- for node in tree %}
        <li class="nav-item">
          {%- if node.children.length %}
          <button class="nav-trigger" type="button" aria-expanded="false" aria-controls="panel-{{ node.key }}">{{ node.title }}{{ icons.icon("chevron", "icon icon-sm chevron") }}</button>
          <div class="mega-panel" id="panel-{{ node.key }}" hidden>
            <div class="mega-inner">
              {%- set loose = [] %}
              {%- for child in node.children %}
                {%- if child.children.length %}
              <div class="mega-col">
                <p class="mega-col-title">{{ child.title }}</p>
                <ul>
                  {%- for leaf in child.children %}
                  <li>{{ menuLink(leaf) }}</li>
                  {%- endfor %}
                </ul>
              </div>
                {%- else %}{% set loose = (loose.push(child), loose) %}{% endif %}
              {%- endfor %}
              {%- if loose.length %}
              <div class="mega-col mega-col-untitled">
                <ul>
                  {%- for leaf in loose %}
                  <li>{{ menuLink(leaf) }}</li>
                  {%- endfor %}
                </ul>
              </div>
              {%- endif %}
            </div>
          </div>
          {%- else %}
          <a class="nav-link" href="{{ node.url }}"{% if node.external %} target="_blank" rel="noopener"{% endif %}{% if node.url == page.url %} aria-current="page"{% endif %}>{{ node.title }}</a>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
      <a class="phone-btn phone-btn-mobile" href="tel:{{ site.phoneDial }}">{{ icons.icon("phone") }}<span dir="ltr">{{ site.phoneDisplay }}</span></a>
    </nav>

    <a class="phone-btn phone-btn-desktop" href="tel:{{ site.phoneDial }}">{{ icons.icon("phone") }}<span dir="ltr">{{ site.phoneDisplay }}</span></a>
    <a class="call-icon" href="tel:{{ site.phoneDial }}" aria-label="התקשרו אלינו {{ site.phoneDisplay }}">{{ icons.icon("phone") }}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="פתיחת תפריט">
      <span class="when-closed">{{ icons.icon("menu") }}</span><span class="when-open">{{ icons.icon("close") }}</span>
    </button>
  </div>
</header>
