{#- Service call form (Netlify form "service-call"). -#}
{%- set fields = [
  ["company", "שם חברה", "text", "organization"],
  ["name", "שם מלא", "text", "name"],
  ["phone", "מספר טלפון ישיר", "tel", "tel"],
  ["mobile", "מספר טלפון סלולרי", "tel", "tel"],
  ["email", "דוא\"ל", "email", "email"]
] -%}
<form name="service-call" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" class="form-stack">
  <input type="hidden" name="form-name" value="service-call">
  <input type="hidden" name="subject" value="{{ env.subjectPrefix }}טופס קריאת שירות חדש">
  <p hidden><label>אל תמלאו שדה זה <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
  {%- for f in fields %}
  <div class="field">
    <label for="sc-{{ f[0] }}">{{ f[1] }} <span class="req" aria-hidden="true">*</span></label>
    <input id="sc-{{ f[0] }}" name="{{ f[0] }}" type="{{ f[2] }}" autocomplete="{{ f[3] }}"{% if f[2] != "text" %} dir="ltr"{% endif %} required>
  </div>
  {%- endfor %}
  <div class="field">
    <label for="sc-details">פירוט התקלה <span class="req" aria-hidden="true">*</span></label>
    <textarea id="sc-details" name="details" required></textarea>
  </div>
  <div><button type="submit" class="btn btn-primary">שליחת קריאת שירות</button></div>
</form>
<p class="form-note">בשליחת הטופס אתם מאשרים את <a href="/privacy/">מדיניות הפרטיות</a> שלנו.</p>
