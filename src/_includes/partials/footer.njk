{%- import "partials/icons.njk" as icons -%}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <img class="footer-logo" src="/assets/img/logo.png" alt="{{ site.name }}" width="180" height="44" loading="lazy">
      {%- if site.footerAbout | filled %}<p>{{ site.footerAbout }}</p>{% endif %}
      {%- set socials = [["facebook", "פייסבוק"], ["instagram", "אינסטגרם"], ["linkedin", "לינקדאין"], ["youtube", "יוטיוב"]] %}
      <ul class="social">
        {%- for s in socials %}{% if site.social[s[0]] | filled %}
        <li><a href="{{ site.social[s[0]] }}" target="_blank" rel="noopener" aria-label="{{ s[1] }}">{{ icons.icon(s[0]) }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </div>

    <nav class="footer-links" aria-label="קישורים מהירים">
      <h2>קישורים מהירים</h2>
      <ul>
        <li><a href="/">דף הבית</a></li>
        {%- set aboutUrl = "about" | pageUrlIfExists(collections.all) %}
        {%- if aboutUrl %}<li><a href="{{ aboutUrl }}">עלינו</a></li>{% endif %}
        <li><a href="/support/guides/">מדריכים</a></li>
        <li><a href="/support/service-call/">טופס קריאת שירות</a></li>
        <li><a href="/contact/">צור קשר</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <h2>יצירת קשר</h2>
      <ul>
        <li>{{ icons.icon("phone") }}<a href="tel:{{ site.phoneDial }}" dir="ltr">{{ site.phoneDisplay }}</a></li>
        {%- if site.whatsapp | filled %}<li>{{ icons.icon("whatsapp") }}<a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">וואטסאפ</a></li>{% endif %}
        {%- if site.email | filled %}<li>{{ icons.icon("mail") }}<a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
        {%- if site.address | filled %}<li>{{ icons.icon("pin") }}<span>{{ site.address }}</span></li>{% endif %}
        {%- if site.hours | filled %}<li>{{ icons.icon("clock") }}<span>{{ site.hours }}</span></li>{% endif %}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {{ year }} {{ site.name }}</p>
    <ul class="legal-links">
      <li><a href="/accessibility/">הצהרת נגישות</a></li>
      <li><a href="/privacy/">מדיניות פרטיות</a></li>
    </ul>
  </div>
</footer>
