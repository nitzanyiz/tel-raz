---
layout: layouts/page.njk
wide: true
---
{#- Content page: text + images (position chosen per page), item cards, and
    an optional contact form. -#}
{%- set pos = imagePosition or "side" -%}
{%- set hasImages = images and images.length -%}
<div class="content-layout content-layout--{{ pos if hasImages else 'none' }}">
  {%- if hasImages and pos != "bottom" %}{% include "partials/gallery.njk" %}{% endif %}
  <article class="prose content-text">
    {{ content | safe }}
  </article>
  {%- if hasImages and pos == "bottom" %}{% include "partials/gallery.njk" %}{% endif %}
</div>
{%- if items and items.length %}
<div class="items">
  {%- for item in items %}{% include "partials/item-card.njk" %}{% endfor %}
</div>
{%- endif %}
{%- if contactForm !== false %}
<section class="prose" style="margin-top:32px" data-reveal>
  <h2 class="reveal" style="--i:0">רוצים לשמוע עוד?</h2>
  <p class="reveal" style="--i:1">השאירו פרטים ונחזור אליכם בהקדם.</p>
  <div class="reveal" style="--i:2">{% include "partials/contact-form.njk" %}</div>
</section>
{%- endif %}
