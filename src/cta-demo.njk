---
layout: layouts/base.njk
bodyClass: cta-demo
---
{%- import "partials/icons.njk" as icons -%}

{#- Copy of partials/contact-form.njk with an id prefix (the demo shows it 3 times)
    and the demo button markup. -#}
{%- macro demoForm(p, inline) -%}
<form class="demo-form {{ 'form-inline' if inline else 'form-stack' }}" data-demo-form>
  <div class="field">
    <label for="{{ p }}-name">שם מלא <span class="req" aria-hidden="true">*</span></label>
    <input id="{{ p }}-name" name="name" type="text" autocomplete="name" required>
  </div>
  <div class="field">
    <label for="{{ p }}-phone">טלפון <span class="req" aria-hidden="true">*</span></label>
    <input id="{{ p }}-phone" name="phone" type="tel" autocomplete="tel" dir="ltr" required>
  </div>
  <div class="field">
    <label for="{{ p }}-company">שם חברה <span class="req" aria-hidden="true">*</span></label>
    <input id="{{ p }}-company" name="company" type="text" autocomplete="organization" required>
  </div>
  <button type="submit" class="btn {{ 'btn-light' if inline else 'btn-primary' }} cta-btn">
    <span class="cta-ico ico-ring">{{ icons.icon("phone") }}</span>
    <span class="cta-ico ico-signal" aria-hidden="true"><svg viewBox="0 0 20 20" width="20" height="20"><rect x="1" y="13" width="3.4" height="5" rx="1"/><rect x="6" y="9.5" width="3.4" height="8.5" rx="1"/><rect x="11" y="6" width="3.4" height="12" rx="1"/><rect x="16" y="2" width="3.4" height="16" rx="1"/></svg></span>
    <span class="cta-spin" aria-hidden="true"></span>
    <span class="cta-label">דברו איתנו</span>
  </button>
</form>
<p class="form-note">בשליחת הטופס אתם מאשרים את <a href="/privacy/">מדיניות הפרטיות</a> שלנו.</p>
{%- endmacro -%}

{%- macro waves() -%}
<div class="demo-waves" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
{%- endmacro -%}

<style>
  /* ---------- Demo chrome ---------- */
  .demo-panel { background: #fff; border-bottom: 1px solid var(--border); padding: 16px 0; z-index: 30; }
  @media (min-width: 900px) { .demo-panel { position: sticky; top: calc(var(--header-h) + 8px); box-shadow: 0 6px 18px rgb(20 39 74 / .06); } }
  .demo-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 6px 0; }
  .demo-row > b { min-width: 92px; color: var(--navy); font-size: .95rem; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .chip span { display: inline-block; padding: 6px 14px; border: 1.5px solid var(--border); border-radius: 999px; font-size: .92rem; background: #fff; }
  .chip input:checked + span { border-color: var(--blue); background: var(--blue); color: #fff; }
  .chip input:focus-visible + span { outline: 3px solid rgb(68 107 164 / .45); }
  .demo-replay { padding: 6px 14px; border-radius: 999px; border: 1.5px solid var(--navy); background: #fff; color: var(--navy); font: inherit; font-size: .92rem; cursor: pointer; }
  .demo-note { color: var(--muted); font-size: .88rem; margin: 8px 0 0; }
  .demo-rm { display: none; background: #fff4e5; border: 1px solid #f5c26b; border-radius: 10px; padding: 8px 12px; margin-top: 8px; font-size: .9rem; }
  @media (prefers-reduced-motion: reduce) { .demo-rm { display: block; } }
  .demo-tag { display: inline-block; margin: 40px 0 12px; padding: 4px 12px; border-radius: 8px; background: var(--navy); color: #fff; font-size: .9rem; font-weight: 700; }
  .demo-tag + .demo-tag-desc { color: var(--muted); margin: -4px 0 16px; font-size: .95rem; }

  /* ---------- Button base (all variants) ---------- */
  .cta-btn { position: relative; }
  .cta-ico, .cta-spin { display: none; }
  .cta-ico .icon, .cta-ico svg { width: 20px; height: 20px; display: block; }
  .ico-signal svg { fill: currentColor; }

  /* A: ring – a "brr-brr" double buzz, then a pause */
  [data-btn="ring"] .ico-ring { display: inline-flex; }
  [data-btn="ring"] .is-live .ico-ring { animation: d-ring 3.2s ease-in-out infinite; transform-origin: 50% 60%; }
  [data-btn="ring"] .is-live .cta-btn { animation: d-buzz 3.2s ease-in-out infinite; }
  @keyframes d-ring {
    0%, 4%, 8%, 12%, 16%, 20%, 24%, 28%, 32% { transform: rotate(0); }
    2%, 10%, 18%, 26% { transform: rotate(-18deg); }
    6%, 14%, 22%, 30% { transform: rotate(18deg); }
    34%, 100% { transform: rotate(0); }
  }
  @keyframes d-buzz {
    0%, 4%, 8%, 12%, 16%, 20%, 24%, 28%, 32%, 34%, 100% { transform: translateX(0) rotate(0); }
    2%, 10%, 18%, 26% { transform: translateX(-2px) rotate(-1.5deg); }
    6%, 14%, 22%, 30% { transform: translateX(2px) rotate(1.5deg); }
  }

  /* B: waves out of the button */
  /* Soft glow that swells out of the button and fades (not an outline) */
  [data-btn="waves"] .cta-btn::before, [data-btn="waves"] .cta-btn::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; z-index: -1;
    background: var(--wave); filter: blur(5px); opacity: 0; pointer-events: none;
  }
  .form-inline .cta-btn { --wave: #fff; }
  .form-stack .cta-btn { --wave: var(--blue); }
  [data-btn="waves"] .is-live .cta-btn::before { animation: d-wave 2.8s ease-out infinite; }
  [data-btn="waves"] .is-live .cta-btn::after { animation: d-wave 2.8s ease-out 1.4s infinite; }
  @keyframes d-wave { 0% { transform: scale(1, 1); opacity: .9; } 100% { transform: scale(1.5, 2.6); opacity: 0; } }
  /* Full-width buttons (contact page, inner pages): grow mostly up and down */
  [data-btn="waves"] .is-live.form-stack .cta-btn::before,
  [data-btn="waves"] .is-live.form-stack .cta-btn::after { animation-name: d-wave-wide; }
  @keyframes d-wave-wide { 0% { transform: scale(1, 1); opacity: .8; } 100% { transform: scale(1.1, 2.6); opacity: 0; } }

  /* C: signal bars filling in */
  [data-btn="signal"] .ico-signal { display: inline-flex; }
  [data-btn="signal"] .ico-signal rect { opacity: .3; }
  [data-btn="signal"] .is-live .ico-signal rect { animation: d-bar 2.4s infinite; }
  [data-btn="signal"] .is-live .ico-signal rect:nth-child(2) { animation-delay: .25s; }
  [data-btn="signal"] .is-live .ico-signal rect:nth-child(3) { animation-delay: .5s; }
  [data-btn="signal"] .is-live .ico-signal rect:nth-child(4) { animation-delay: .75s; }
  @keyframes d-bar { 0%, 10% { opacity: .3; } 20%, 70% { opacity: 1; } 85%, 100% { opacity: .3; } }

  /* D: shine sweep */
  [data-btn="shine"] .cta-btn { overflow: hidden; }
  [data-btn="shine"] .cta-btn::after {
    content: ""; position: absolute; top: 0; bottom: 0; width: 40%; left: -60%; pointer-events: none;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / .75), transparent);
    transform: skewX(-20deg);
  }
  [data-btn="shine"] .form-inline .cta-btn::after { background: linear-gradient(100deg, transparent, rgb(68 107 164 / .35), transparent); }
  [data-btn="shine"] .is-live .cta-btn::after { animation: d-shine 3.5s ease-in-out infinite; }
  @keyframes d-shine { 0% { left: -60%; } 30%, 100% { left: 130%; } }

  /* E: magnetic (JS moves it) */
  [data-btn="magnet"] .cta-btn { transition: transform .25s ease-out, background-color .2s, color .2s; }

  /* While the visitor is filling the form (and after the cap): back to the plain, still button */
  .is-engaged .cta-btn, .is-engaged .cta-btn *, .is-engaged .cta-btn::before, .is-engaged .cta-btn::after,
  .is-done .cta-btn, .is-done .cta-btn *, .is-done .cta-btn::before, .is-done .cta-btn::after { animation: none !important; }

  /* Send feedback: spinner, then ✓ */
  .cta-btn.is-sending .cta-spin { display: inline-block; width: 18px; height: 18px; border-radius: 50%; border: 2.5px solid currentColor; border-top-color: transparent; animation: d-spin .8s linear infinite !important; animation-play-state: running !important; }
  .cta-btn.is-sending .cta-ico, .cta-btn.is-sent .cta-ico { display: none !important; }
  .cta-btn.is-sent { background: #1d8a4e !important; color: #fff !important; }
  @keyframes d-spin { to { transform: rotate(360deg); } }

  /* ---------- Section effects ---------- */
  .demo-sec { position: relative; overflow: hidden; }
  .demo-sec > :not(.demo-waves) { position: relative; z-index: 1; }
  .contact-strip.demo-sec > .container { position: relative; z-index: 1; }

  /* Entrance: staggered rise, once */
  [data-sec="enter"] .demo-sec .d-in { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; transition-delay: calc(var(--i, 0) * 90ms); }
  [data-sec="enter"] .demo-sec.is-in .d-in { opacity: 1; transform: none; }

  /* Waves layer (behind the title, or from the button) */
  .demo-waves { display: none; position: absolute; inset: 0; z-index: 0; pointer-events: none; color: #fff; }
  .prose.demo-sec .demo-waves { color: var(--blue); }
  [data-sec="waves"] .demo-waves, [data-sec="wavesbtn"] .demo-waves { display: block; }
  /* Each wave is a soft band of light (fades in toward its edge, then out), not a line */
  .demo-waves i {
    position: absolute; left: var(--ox, 50%); top: var(--oy, 30%); width: 0; height: 0;
    border-radius: 50%; transform: translate(-50%, -50%); opacity: 0;
    background: radial-gradient(closest-side, transparent 55%, currentColor 82%, transparent 100%);
  }
  .is-live .demo-waves i, .demo-sec.is-live .demo-waves i { animation: d-bigwave 8s linear infinite; }
  .demo-waves i:nth-child(2) { animation-delay: 2s !important; }
  .demo-waves i:nth-child(3) { animation-delay: 4s !important; }
  .demo-waves i:nth-child(4) { animation-delay: 6s !important; }
  @keyframes d-bigwave { 0% { width: 0; height: 0; opacity: .16; } 100% { width: 1800px; height: 1800px; opacity: 0; } }
  @keyframes d-bigwave-light { 0% { width: 0; height: 0; opacity: .14; } 100% { width: 1400px; height: 1400px; opacity: 0; } }
  .prose.demo-sec.is-live .demo-waves i { animation-name: d-bigwave-light; }

  /* ---------- Validation B: our own messages ---------- */
  .field-error { margin: 0; font-size: .88rem; font-weight: 500; color: #b42318; display: flex; gap: 6px; align-items: center; }
  .field-error::before { content: "!"; flex: none; width: 16px; height: 16px; border-radius: 50%; background: currentColor; color: #fff; font-size: .7rem; font-weight: 800; display: grid; place-items: center; line-height: 1; }
  .contact-strip .field-error { color: #ffc4ba; }
  .contact-strip .field-error::before { background: #ffc4ba; color: var(--navy-dark); }
  input[aria-invalid="true"], textarea[aria-invalid="true"] { border-color: #b42318; box-shadow: 0 0 0 1px #b42318; }
  .contact-strip input[aria-invalid="true"] { border-color: #ffb4a8; box-shadow: 0 0 0 1px #ffb4a8; }
  @media (min-width: 761px) {
    .form-inline .field { position: relative; }
    .form-inline .field-error { position: absolute; top: calc(100% + 6px); right: 0; }
    .form-inline.has-errors { padding-bottom: 28px; }
  }
  .demo-toast { margin-top: 12px; font-weight: 700; }
</style>

<section class="page-hero">
  <div class="container">
    <h1>הדגמה: כפתור שליחה ואזור "רוצים לשמוע עוד?"</h1>
    <p class="lead">בחרו אפשרויות למעלה – הן מופעלות על שלושת המקומות בהם הטופס מופיע. הטפסים כאן לא נשלחים.</p>
  </div>
</section>

<div class="demo-panel" data-demo-panel>
  <div class="container">
    <div class="demo-row"><b>כפתור:</b>
      {%- for v in [["none","ללא (כמו היום)"],["ring","א. צלצול טלפון"],["waves","ב. גלים מהכפתור"],["signal","ג. פסי קליטה"],["shine","ד. ברק חולף"],["magnet","ה. מגנטי (עכבר)"]] %}
      <label class="chip"><input type="radio" name="d-btn" value="{{ v[0] }}"{% if loop.first %} checked{% endif %}><span>{{ v[1] }}</span></label>
      {%- endfor %}
    </div>
    <div class="demo-row"><b>האזור:</b>
      {%- for v in [["none","ללא"],["enter","כניסה מדורגת"],["waves","גלי רקע"],["wavesbtn","גלים מתוך הכפתור"]] %}
      <label class="chip"><input type="radio" name="d-sec" value="{{ v[0] }}"{% if loop.first %} checked{% endif %}><span>{{ v[1] }}</span></label>
      {%- endfor %}
      <button type="button" class="demo-replay" data-replay>↺ הפעלה מחדש</button>
    </div>
    <div class="demo-row"><b>ולידציה:</b>
      {%- for v in [["native","דפדפן (כמו היום)"],["he","א. בועות דפדפן בעברית"],["custom","ב. הודעות שלנו"]] %}
      <label class="chip"><input type="radio" name="d-val" value="{{ v[0] }}"{% if v[0] == "custom" %} checked{% endif %}><span>{{ v[1] }}</span></label>
      {%- endfor %}
    </div>
    <div class="demo-row"><b>אחרי לחיצה:</b>
      <label class="chip"><input type="radio" name="d-fb" value="on" checked><span>טוען ← ✓ נשלח</span></label>
      <label class="chip"><input type="radio" name="d-fb" value="off"><span>ללא</span></label>
    </div>
    <p class="demo-note">האנימציה פועלת רק כשהטופס על המסך, נעצרת כשמתחילים למלא (וחוזרת אם יוצאים בלי להקליד), ונעצרת לגמרי אחרי כ-30 שניות.</p>
    <p class="demo-rm">שימו לב: במחשב הזה מופעלת ההגדרה "הפחתת תנועה", ולכן האנימציות לא יוצגו (כך זה יתנהג גם באתר).</p>
  </div>
</div>

<div class="container"><span class="demo-tag">1. עמוד הבית</span><p class="demo-tag-desc">הפס הכהה בתחתית עמוד הבית.</p></div>
<section class="contact-strip demo-sec">
  {{ waves() }}
  <div class="container">
    <h2 class="d-in" style="--i:0">{{ home.contactTitle }}</h2>
    <p class="strip-text d-in" style="--i:1">{{ home.contactText }}</p>
    <div class="d-in" style="--i:2">{{ demoForm("h", true) }}</div>
  </div>
</section>

<div class="page-body">
  <div class="container">
    <span class="demo-tag">2. עמוד צור קשר</span>
    <div class="contact-layout">
      <div class="prose">
        <h2>צור קשר</h2>
        <ul class="details-list">
          <li>{{ icons.icon("phone") }}<span dir="ltr">{{ site.phoneDisplay }}</span></li>
          {%- if site.email | filled %}<li>{{ icons.icon("mail") }}<span>{{ site.email }}</span></li>{% endif %}
          {%- if site.address | filled %}<li>{{ icons.icon("pin") }}<span>{{ site.address }}</span></li>{% endif %}
        </ul>
      </div>
      <div class="prose demo-sec">
        {{ waves() }}
        <h2 class="d-in" style="--i:0">השאירו פרטים</h2>
        <div class="d-in" style="--i:1">{{ demoForm("c", false) }}</div>
      </div>
    </div>

    <span class="demo-tag">3. תחתית עמוד פנימי</span><p class="demo-tag-desc">מופיע בסוף עמודי התוכן והשירותים.</p>
    <section class="prose demo-sec">
      {{ waves() }}
      <h2 class="d-in" style="--i:0">רוצים לשמוע עוד?</h2>
      <p class="d-in" style="--i:1">השאירו פרטים ונחזור אליכם בהקדם.</p>
      <div class="d-in" style="--i:2">{{ demoForm("p", false) }}</div>
    </section>

    <span class="demo-tag">טופס קריאת שירות (ולידציה בלבד)</span><p class="demo-tag-desc">הוולידציה בעברית תחול גם עליו.</p>
    <section class="prose">
      <form class="form-stack" data-demo-form data-plain>
        {%- for f in [["company","שם חברה","text"],["name","שם מלא","text"],["phone","מספר טלפון ישיר","tel"],["email","דוא\"ל","email"]] %}
        <div class="field">
          <label for="s-{{ f[0] }}">{{ f[1] }} <span class="req" aria-hidden="true">*</span></label>
          <input id="s-{{ f[0] }}" name="{{ f[0] }}" type="{{ f[2] }}"{% if f[2] != "text" %} dir="ltr"{% endif %} required>
        </div>
        {%- endfor %}
        <div class="field">
          <label for="s-details">פירוט התקלה <span class="req" aria-hidden="true">*</span></label>
          <textarea id="s-details" name="details" required></textarea>
        </div>
        <div><button type="submit" class="btn btn-primary cta-btn"><span class="cta-spin" aria-hidden="true"></span><span class="cta-label">שליחת קריאת שירות</span></button></div>
      </form>
    </section>
  </div>
</div>

<script>
(function () {
  const body = document.body;
  const forms = [...document.querySelectorAll("[data-demo-form]")];
  const secs = [...document.querySelectorAll(".demo-sec")];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const CAP_MS = 30000;

  // ---------- Options ----------
  function readOpt(name) { return document.querySelector(`input[name="${name}"]:checked`).value; }
  function apply() {
    body.dataset.btn = readOpt("d-btn");
    body.dataset.sec = readOpt("d-sec");
    body.dataset.val = readOpt("d-val");
    body.dataset.fb = readOpt("d-fb");
    forms.forEach((f) => { f.noValidate = body.dataset.val === "custom"; clearErrors(f); });
    replay();
  }
  document.querySelector("[data-demo-panel]").addEventListener("change", apply);
  document.querySelector("[data-replay]").addEventListener("click", replay);

  // ---------- Live only while on screen; paused while filling; capped ----------
  const animated = forms.filter((f) => !f.hasAttribute("data-plain"));
  const state = new Map(animated.map((f) => [f, { visibleMs: 0, since: 0 }]));
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      const f = e.target, s = state.get(f);
      if (e.isIntersecting) { f.classList.add("is-live"); s.since = performance.now(); }
      else { f.classList.remove("is-live"); if (s.since) s.visibleMs += performance.now() - s.since; s.since = 0; }
    });
  }, { threshold: 0.4 });
  animated.forEach((f) => io.observe(f));
  setInterval(() => {
    state.forEach((s, f) => {
      const total = s.visibleMs + (s.since ? performance.now() - s.since : 0);
      if (total > CAP_MS && !f.classList.contains("is-engaged")) f.classList.add("is-done");
    });
  }, 500);

  animated.forEach((f) => {
    f.addEventListener("focusin", () => f.classList.add("is-engaged"));
    f.addEventListener("focusout", () => setTimeout(() => {
      if (f.contains(document.activeElement)) return;
      const typed = [...f.elements].some((el) => el.value && el.type !== "submit");
      if (!typed) f.classList.remove("is-engaged");
    }));
  });

  // Section waves and entrance follow the section's visibility.
  const secIo = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      e.target.classList.toggle("is-live", e.isIntersecting);
      if (e.isIntersecting) e.target.classList.add("is-in");
    });
  }, { threshold: 0.25 });
  secs.forEach((s) => secIo.observe(s));

  function placeWaves() {
    secs.forEach((sec) => {
      const layer = sec.querySelector(".demo-waves");
      const r = sec.getBoundingClientRect();
      if (body.dataset.sec === "wavesbtn") {
        const b = sec.querySelector(".cta-btn").getBoundingClientRect();
        layer.style.setProperty("--ox", `${b.left + b.width / 2 - r.left}px`);
        layer.style.setProperty("--oy", `${b.top + b.height / 2 - r.top}px`);
      } else {
        const h = sec.querySelector("h2").getBoundingClientRect();
        layer.style.setProperty("--ox", "50%");
        layer.style.setProperty("--oy", `${h.top + h.height / 2 - r.top}px`);
      }
    });
  }
  addEventListener("resize", placeWaves);

  function replay() {
    animated.forEach((f) => {
      f.classList.remove("is-done", "is-engaged");
      const s = state.get(f); s.visibleMs = 0; if (s.since) s.since = performance.now();
      const btn = f.querySelector(".cta-btn"); btn.style.transform = "";
    });
    secs.forEach((s) => { s.classList.remove("is-in"); void s.offsetWidth; });
    requestAnimationFrame(() => {
      placeWaves();
      secs.forEach((s) => { const r = s.getBoundingClientRect(); if (r.top < innerHeight && r.bottom > 0) s.classList.add("is-in"); });
    });
  }

  // ---------- Magnetic button (mouse only) ----------
  const fine = matchMedia("(hover: hover) and (pointer: fine)");
  addEventListener("pointermove", (e) => {
    if (body.dataset.btn !== "magnet" || !fine.matches || reduce.matches) return;
    animated.forEach((f) => {
      const btn = f.querySelector(".cta-btn");
      if (f.classList.contains("is-engaged") || btn.classList.contains("is-sending")) { btn.style.transform = ""; return; }
      const r = btn.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
      const near = Math.abs(dx) < r.width / 2 + 70 && Math.abs(dy) < r.height / 2 + 50;
      btn.style.transform = near ? `translate(${dx * 0.22}px, ${dy * 0.3}px)` : "";
    });
  });

  // ---------- Validation ----------
  const MSG = {
    required: "נא למלא שדה זה",
    email: "נא להזין כתובת דוא\"ל תקינה, למשל name@company.co.il",
    phone: "נא להזין מספר טלפון תקין, למשל 050-1234567",
  };
  // Israeli number: 9–10 digits starting with 0, or with +972 / 972 prefix.
  const phoneOk = (v) => /^(0\d{8,9}|972\d{8,9})$/.test(v.replace(/[\s\-().]/g, "").replace(/^\+/, ""));

  function problem(el) {
    const v = el.value.trim();
    if (el.required && !v) return MSG.required;
    if (el.type === "email" && v && (el.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v))) return MSG.email;
    if (el.type === "tel" && v && !phoneOk(v)) return MSG.phone;
    return "";
  }
  const fieldsOf = (f) => [...f.querySelectorAll("input:not([type=hidden]), textarea")];

  function showError(el, msg) {
    const field = el.closest(".field");
    let p = field.querySelector(".field-error");
    if (!msg) { if (p) p.remove(); el.removeAttribute("aria-invalid"); el.removeAttribute("aria-describedby"); }
    else {
      if (!p) { p = document.createElement("p"); p.className = "field-error"; p.id = el.id + "-err"; field.appendChild(p); }
      p.textContent = msg;
      el.setAttribute("aria-invalid", "true"); el.setAttribute("aria-describedby", p.id);
    }
    const form = el.form; form.classList.toggle("has-errors", !!form.querySelector(".field-error"));
  }
  function clearErrors(f) { fieldsOf(f).forEach((el) => { showError(el, ""); el.setCustomValidity(""); delete el.dataset.touched; }); }

  forms.forEach((f) => {
    fieldsOf(f).forEach((el) => {
      // Option A: Hebrew text inside the browser's own bubble.
      el.addEventListener("invalid", () => { if (body.dataset.val === "he") el.setCustomValidity(problem(el)); });
      el.addEventListener("input", () => {
        if (body.dataset.val === "he") el.setCustomValidity(problem(el) === MSG.required ? "" : problem(el));
        if (body.dataset.val === "custom" && el.dataset.touched) showError(el, problem(el));
      });
      // Option B: check a field once the visitor leaves it (only if they typed something).
      el.addEventListener("blur", () => {
        if (body.dataset.val !== "custom" || !el.value.trim()) return;
        el.dataset.touched = "1"; showError(el, problem(el));
      });
    });

    f.addEventListener("submit", (e) => {
      e.preventDefault();
      if (body.dataset.val === "he") {
        // Phone format is not checked by the browser: add it, then let it show the bubble.
        fieldsOf(f).forEach((el) => el.setCustomValidity(problem(el)));
        if (!f.reportValidity()) return;
      }
      if (body.dataset.val === "custom") {
        const bad = fieldsOf(f).filter((el) => { el.dataset.touched = "1"; const m = problem(el); showError(el, m); return m; });
        if (bad.length) { bad[0].focus(); return; }
      }
      if (body.dataset.val === "native" && !f.checkValidity()) return;
      fakeSend(f);
    });
  });

  function fakeSend(f) {
    const btn = f.querySelector(".cta-btn"), label = btn.querySelector(".cta-label");
    const orig = label.textContent;
    const done = () => { f.reset(); clearErrors(f); setTimeout(() => { btn.classList.remove("is-sent"); label.textContent = orig; btn.disabled = false; }, 2500); };
    if (body.dataset.fb === "off") { label.textContent = "(הדגמה – לא נשלח)"; btn.disabled = true; done(); return; }
    btn.disabled = true; btn.classList.add("is-sending"); label.textContent = "שולח...";
    setTimeout(() => { btn.classList.remove("is-sending"); btn.classList.add("is-sent"); label.textContent = "✓ נשלח!"; done(); }, 1300);
  }

  apply();
})();
</script>
